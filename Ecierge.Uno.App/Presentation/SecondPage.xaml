<Page x:Class="Ecierge.Uno.App.Presentation.SecondPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ct="using:CommunityToolkit.WinUI"
      xmlns:i="using:Microsoft.Xaml.Interactivity"
      xmlns:local="using:Ecierge.Uno.App.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:nav="using:Ecierge.Uno.Navigation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="NavigationRegionStates">
        <VisualState x:Name="DetailsState">
          <VisualState.StateTriggers>
            <ct:IsEqualStateTrigger Value="{Binding Path=(nav:NavigationRegion.NestedSegmentName), ElementName=SelectorBar}" To="Details" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="DetailsContent.Visibility" Value="Visible" />
            <Setter Target="NotesContent.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="NotesState">
          <VisualState.StateTriggers>
            <ct:IsEqualStateTrigger Value="{Binding Path=(nav:NavigationRegion.NestedSegmentName), ElementName=SelectorBar}" To="Notes" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="DetailsContent.Visibility" Value="Collapsed" />
            <Setter Target="NotesContent.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <utu:NavigationBar Content="Second Page">
      <utu:NavigationBar.MainCommand>
        <AppBarButton>
          <AppBarButton.Icon>
            <BitmapIcon UriSource="ms-appx:///Assets/Images/back.png" />
          </AppBarButton.Icon>
          <i:Interaction.Behaviors>
            <i:EventTriggerBehavior EventName="Click">
              <nav:NavigateBackAction />
            </i:EventTriggerBehavior>
          </i:Interaction.Behaviors>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>
    <StackPanel Grid.Row="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Margin="8" />
      <!-- The last breadcrumb runs the RefreshCommand of the view model, which loads the entity again -->
      <TextBlock Text="{Binding LoadedAt}" HorizontalAlignment="Center" />
      <TextBlock Text="Click the last breadcrumb to load the entity again."
                 HorizontalAlignment="Center"
                 Margin="0,0,0,8"
                 Style="{ThemeResource CaptionTextBlockStyle}" />
      <SelectorBar x:Name="SelectorBar" HorizontalAlignment="Center" nav:NavigationRegion.Attach="True">
        <SelectorBarItem x:Name="DetailsItem" nav:Route.SegmentName="Details" Text="Details" />
        <SelectorBarItem x:Name="NotesItem" nav:Route.SegmentName="Notes" Text="Notes" />
      </SelectorBar>
      <Grid Margin="0,8">
        <TextBlock x:Name="DetailsContent" HorizontalAlignment="Center" Visibility="Collapsed">Details of the entity</TextBlock>
        <TextBlock x:Name="NotesContent" HorizontalAlignment="Center" Visibility="Collapsed">Notes about the entity</TextBlock>
      </Grid>
      <Button Content="Go to Main default from root">
        <i:Interaction.Behaviors>
          <i:EventTriggerBehavior EventName="Click">
            <nav:NavigateRootRouteAction Route="Main" />
          </i:EventTriggerBehavior>
        </i:Interaction.Behaviors>
      </Button>
      <Button Content="Go to Main Tab2 from root">
        <i:Interaction.Behaviors>
          <i:EventTriggerBehavior EventName="Click">
            <nav:NavigateRootRouteAction Route="Main/Tab2" />
          </i:EventTriggerBehavior>
        </i:Interaction.Behaviors>
      </Button>
      <Button Content="Go to Main default local">
        <i:Interaction.Behaviors>
          <i:EventTriggerBehavior EventName="Click">
            <nav:NavigateLocalRouteAction Route="Main" />
          </i:EventTriggerBehavior>
        </i:Interaction.Behaviors>
      </Button>
      <Button Content="Go to Main Tab2 local">
        <i:Interaction.Behaviors>
          <i:EventTriggerBehavior EventName="Click">
            <nav:NavigateLocalRouteAction Route="Main/Tab2" />
          </i:EventTriggerBehavior>
        </i:Interaction.Behaviors>
      </Button>
    </StackPanel>

  </Grid>
</Page>
