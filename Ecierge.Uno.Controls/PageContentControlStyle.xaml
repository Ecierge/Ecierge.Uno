<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Ecierge.Uno.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///Ecierge.Uno.Controls/Resources.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="PageContentControl" TargetType="local:PageContentControl">
    <Setter Property="FooterBackground" Value="{ThemeResource PageAppBarAcrylicBrush}" />
    <Setter Property="HeaderBackground" Value="{ThemeResource PageAppBarAcrylicBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:PageContentControl">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Grid RowDefinitions="Auto,*">
              <!--
                The title, the header and the footer are ContentControls, not ContentPresenters: a ContentPresenter in the template of a
                ContentControl falls back to the Content, ContentTemplate and ContentTemplateSelector of the control while its own are empty.
              -->
              <ContentControl x:Name="TitlePresenter"
                              Grid.Row="0"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              Content="{TemplateBinding Title}"
                              ContentTemplate="{TemplateBinding TitleTemplate}"
                              IsTabStop="False" />
              <Grid Grid.Row="1">
                <!-- Declared before the scroll viewer to come first in the tab order; Canvas.ZIndex keeps it above the content that scrolls under it. -->
                <Grid x:Name="HeaderPanel"
                      RowDefinitions="Auto,Auto"
                      VerticalAlignment="Top"
                      Background="{TemplateBinding HeaderBackground}"
                      Canvas.ZIndex="1">
                  <Border Grid.Row="0" Height="{TemplateBinding TopBorderHeight}" />
                  <ContentControl x:Name="HeaderPresenter"
                                  Grid.Row="1"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  IsTabStop="False" />
                </Grid>
                <ScrollViewer x:Name="ScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto"
                              VerticalScrollBarVisibility="Hidden">
                  <ContentPresenter x:Name="ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                </ScrollViewer>
                <Grid x:Name="FooterPanel"
                      VerticalAlignment="Bottom"
                      Background="{TemplateBinding FooterBackground}"
                      Canvas.ZIndex="1">
                  <ContentControl x:Name="FooterPresenter"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  Content="{TemplateBinding Footer}"
                                  ContentTemplate="{TemplateBinding FooterTemplate}"
                                  IsTabStop="False" />
                </Grid>
                <!-- The scroll viewer hides its own bar: this one stays between the header and the footer (PageContentControl.UpdateInsets). -->
                <ScrollBar x:Name="VerticalScrollBar"
                           Width="8"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Canvas.ZIndex="2"
                           IndicatorMode="MouseIndicator"
                           Minimum="0"
                           Orientation="Vertical"
                           Visibility="Collapsed" />
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style TargetType="local:PageContentControl" BasedOn="{StaticResource PageContentControl}" />
</ResourceDictionary>
